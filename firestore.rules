rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 4.1: Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // Phase 3: Global Hardened Primitives
    // =========================================================================
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isBootstrapAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'royalvalue59@gmail.com';
    }
    function isAdmin() {
      return isBootstrapAdmin() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }
    function parentUserExists(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }
    function isValidTags(tags) {
      return tags is list &&
        tags.size() <= 5 &&
        (tags.size() == 0 || (tags[0] is string && tags[0].size() >= 1 && tags[0].size() <= 40));
    }
    function isValidBackupMetrics(m) {
      return m is map &&
        m.keys().hasAll(['institutions', 'users', 'students', 'teachers', 'transactions', 'notices']) &&
        m.keys().hasOnly(['institutions', 'users', 'students', 'teachers', 'transactions', 'notices']) &&
        m.institutions is int && m.institutions >= 0 &&
        m.users is int && m.users >= 0 &&
        m.students is int && m.students >= 0 &&
        m.teachers is int && m.teachers >= 0 &&
        m.transactions is int && m.transactions >= 0 &&
        m.notices is int && m.notices >= 0;
    }

    // =========================================================================
    // Validation Blueprints (Anti-Update-Gap) — Mirrors firebase-blueprint.json
    // =========================================================================
    function isValidPublicUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'preferredTheme', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'preferredTheme', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        (data.uid == request.auth.uid || isBootstrapAdmin()) &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
        data.preferredTheme is string && data.preferredTheme.size() <= 10 &&
        data.preferredTheme in ['light', 'dark'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPrivateUserProfile(data) {
      return data.keys().hasAll([
          'uid', 'email', 'photoURL', 'linkedUsername',
          'linkedAccountType', 'linkedInstitutionName', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'email', 'photoURL', 'linkedUsername',
          'linkedAccountType', 'linkedInstitutionName', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.uid) &&
        ((data.uid == request.auth.uid && data.email == request.auth.token.email) || isBootstrapAdmin()) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.photoURL is string && data.photoURL.size() <= 500 &&
        data.linkedUsername is string && data.linkedUsername.size() <= 64 &&
        data.linkedAccountType is string && data.linkedAccountType.size() <= 32 &&
        data.linkedAccountType in ['', 'super_admin', 'institution_admin', 'teacher', 'staff', 'student', 'guardian'] &&
        data.linkedInstitutionName is string && data.linkedInstitutionName.size() <= 120 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAdminRecord(data, userId) {
      return data.keys().hasAll(['uid', 'label', 'grantedBy', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'label', 'grantedBy', 'createdAt']) &&
        isValidId(data.uid) &&
        data.uid == userId &&
        data.label is string && data.label.size() >= 1 && data.label.size() <= 80 &&
        isValidId(data.grantedBy) &&
        data.grantedBy == request.auth.uid &&
        data.createdAt is timestamp;
    }

    function isValidCloudInstitution(data) {
      return data.keys().hasAll([
          'ownerId', 'institutionCode', 'name', 'status', 'academicYear',
          'studentCount', 'teacherCount', 'totalIncome', 'totalExpense',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'institutionCode', 'name', 'status', 'academicYear',
          'studentCount', 'teacherCount', 'totalIncome', 'totalExpense',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.ownerId) &&
        (data.ownerId == request.auth.uid || isBootstrapAdmin()) &&
        data.institutionCode is string && data.institutionCode.size() >= 1 && data.institutionCode.size() <= 40 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.status is string && data.status.size() <= 20 &&
        data.status in ['active', 'draft', 'pending', 'suspended'] &&
        data.academicYear is string && data.academicYear.size() <= 40 &&
        data.studentCount is int && data.studentCount >= 0 && data.studentCount <= 1000000 &&
        data.teacherCount is int && data.teacherCount >= 0 && data.teacherCount <= 100000 &&
        data.totalIncome is number && data.totalIncome >= 0 &&
        data.totalExpense is number && data.totalExpense >= 0 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCloudBackup(data) {
      return data.keys().hasAll([
          'ownerId', 'scope', 'title', 'institutionName', 'recordCount',
          'status', 'summaryText', 'exportedAtDhaka', 'metrics', 'tags',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'scope', 'title', 'institutionName', 'recordCount',
          'status', 'summaryText', 'exportedAtDhaka', 'metrics', 'tags',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.ownerId) &&
        (data.ownerId == request.auth.uid || isBootstrapAdmin()) &&
        data.scope is string && data.scope.size() <= 20 && data.scope in ['platform', 'institution'] &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
        data.institutionName is string && data.institutionName.size() <= 120 &&
        data.recordCount is int && data.recordCount >= 0 && data.recordCount <= 10000000 &&
        data.status is string && data.status.size() <= 20 && data.status in ['active', 'archived'] &&
        data.summaryText is string && data.summaryText.size() <= 2000 &&
        data.exportedAtDhaka is string && data.exportedAtDhaka.size() >= 1 && data.exportedAtDhaka.size() <= 40 &&
        isValidBackupMetrics(data.metrics) &&
        isValidTags(data.tags) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCloudNote(data) {
      return data.keys().hasAll(['ownerId', 'title', 'body', 'category', 'status', 'tags', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerId', 'title', 'body', 'category', 'status', 'tags', 'createdAt', 'updatedAt']) &&
        isValidId(data.ownerId) &&
        (data.ownerId == request.auth.uid || isBootstrapAdmin()) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
        data.body is string && data.body.size() >= 1 && data.body.size() <= 2000 &&
        data.category is string && data.category.size() <= 20 &&
        data.category in ['general', 'academic', 'finance', 'hostel', 'support'] &&
        data.status is string && data.status.size() <= 12 &&
        data.status in ['open', 'done'] &&
        isValidTags(data.tags) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCloudAnnouncement(data) {
      return data.keys().hasAll(['authorId', 'title', 'message', 'priority', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['authorId', 'title', 'message', 'priority', 'status', 'createdAt', 'updatedAt']) &&
        isValidId(data.authorId) &&
        (data.authorId == request.auth.uid || isBootstrapAdmin()) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 150 &&
        data.message is string && data.message.size() >= 1 && data.message.size() <= 2000 &&
        data.priority is string && data.priority.size() <= 20 &&
        data.priority in ['normal', 'important', 'urgent'] &&
        data.status is string && data.status.size() <= 20 &&
        data.status in ['draft', 'published', 'archived'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // =========================================================================
    // Collection 1: /users/{userId} (Non-PII Public Profile)
    // =========================================================================
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if false;

      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        isOwner(userId) &&
        isValidPublicUserProfile(incoming()) &&
        incoming().uid == userId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        isValidPublicUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'preferredTheme', 'updatedAt'])) ||
          isAdmin()
        );

      allow delete: if isAdmin() && isValidId(userId);

      // -----------------------------------------------------------------------
      // Collection 2: /users/{userId}/private/{docId} (PII Isolated, Master Gate)
      // -----------------------------------------------------------------------
      match /private/{docId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(docId) && (isOwner(userId) || isAdmin());
        allow list: if false;

        allow create: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(docId) &&
          docId == 'info' &&
          isOwner(userId) &&
          isValidPrivateUserProfile(incoming()) &&
          incoming().uid == userId &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          parentUserExists(userId);

        allow update: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(docId) &&
          docId == 'info' &&
          isValidPrivateUserProfile(incoming()) &&
          incoming().uid == existing().uid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          parentUserExists(userId) &&
          (
            (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly([
              'email', 'photoURL', 'linkedUsername', 'linkedAccountType', 'linkedInstitutionName', 'updatedAt'
            ])) ||
            isAdmin()
          );

        allow delete: if isSignedIn() && isValidId(userId) && isValidId(docId) && (isOwner(userId) || isAdmin());
      }

      // -----------------------------------------------------------------------
      // Collection 3: /users/{userId}/notes/{noteId} (Real-time Workspace Notes)
      // -----------------------------------------------------------------------
      match /notes/{noteId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(noteId) && (isOwner(userId) || isAdmin());
        allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;

        allow create: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(noteId) &&
          isOwner(userId) &&
          isValidCloudNote(incoming()) &&
          incoming().ownerId == userId &&
          incoming().status == 'open' &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          parentUserExists(userId);

        allow update: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(noteId) &&
          isValidCloudNote(incoming()) &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          parentUserExists(userId) &&
          (
            (isOwner(userId) && existing().status != 'done' &&
              incoming().diff(existing()).affectedKeys().hasOnly(['title', 'body', 'category', 'tags', 'updatedAt'])) ||
            (isOwner(userId) && existing().status != 'done' && incoming().status == 'done' &&
              incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
            isAdmin()
          );

        allow delete: if isVerifiedUser() && isValidId(userId) && isValidId(noteId) &&
          parentUserExists(userId) && (isOwner(userId) || isAdmin());
      }
    }

    // =========================================================================
    // Collection 4: /admins/{userId} (Trusted Platform Admin Registry)
    // =========================================================================
    match /admins/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isBootstrapAdmin();

      allow create: if isAdmin() &&
        isValidId(userId) &&
        isValidAdminRecord(incoming(), userId) &&
        incoming().createdAt == request.time;

      allow update: if false;
      allow delete: if isBootstrapAdmin() && isValidId(userId);
    }

    // =========================================================================
    // Collection 5: /institutions/{institutionId} (Cloud Synced Madrasas)
    // =========================================================================
    match /institutions/{institutionId} {
      allow get: if isSignedIn() && isValidId(institutionId) && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isBootstrapAdmin());

      allow create: if isVerifiedUser() &&
        isValidId(institutionId) &&
        isValidCloudInstitution(incoming()) &&
        incoming().ownerId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        parentUserExists(request.auth.uid);

      allow update: if isVerifiedUser() &&
        isValidId(institutionId) &&
        isValidCloudInstitution(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().institutionCode == existing().institutionCode &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (existing().ownerId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'status', 'academicYear', 'studentCount', 'teacherCount',
              'totalIncome', 'totalExpense', 'updatedAt'
            ])) ||
          isAdmin()
        );

      allow delete: if isVerifiedUser() && isValidId(institutionId) &&
        (existing().ownerId == request.auth.uid || isAdmin());
    }

    // =========================================================================
    // Collection 6: /cloudBackups/{backupId} (Owner-Scoped Cloud Snapshots)
    // =========================================================================
    match /cloudBackups/{backupId} {
      allow get: if isSignedIn() && isValidId(backupId) && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isBootstrapAdmin());

      allow create: if isVerifiedUser() &&
        isValidId(backupId) &&
        isValidCloudBackup(incoming()) &&
        incoming().ownerId == request.auth.uid &&
        incoming().status == 'active' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        parentUserExists(request.auth.uid);

      allow update: if isVerifiedUser() &&
        isValidId(backupId) &&
        isValidCloudBackup(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().scope == existing().scope &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (existing().ownerId == request.auth.uid && existing().status != 'archived' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'summaryText', 'tags', 'updatedAt'])) ||
          (existing().ownerId == request.auth.uid && existing().status != 'archived' && incoming().status == 'archived' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
          isAdmin()
        );

      allow delete: if isVerifiedUser() && isValidId(backupId) &&
        (existing().ownerId == request.auth.uid || isAdmin());
    }

    // =========================================================================
    // Collection 7: /announcements/{announcementId} (Admin Cloud Announcements)
    // =========================================================================
    match /announcements/{announcementId} {
      allow get: if isSignedIn() && isValidId(announcementId) && (resource.data.status == 'published' || isAdmin());
      allow list: if isSignedIn() && (resource.data.status == 'published' || isBootstrapAdmin());

      allow create: if isVerifiedUser() &&
        isValidId(announcementId) &&
        isValidCloudAnnouncement(incoming()) &&
        incoming().authorId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();

      allow update: if isVerifiedUser() &&
        isValidId(announcementId) &&
        isValidCloudAnnouncement(incoming()) &&
        incoming().authorId == existing().authorId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAdmin() &&
        (
          (existing().status != 'archived' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'message', 'priority', 'status', 'updatedAt'])) ||
          isBootstrapAdmin()
        );

      allow delete: if isVerifiedUser() && isValidId(announcementId) && isAdmin();
    }
  }
}
